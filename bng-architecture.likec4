// BNG Metric Architecture - LikeC4 Definition
// Generic BNG Proposed Architecture - High Level

specification {
  element actor {
    style {
      shape person
      color amber
    }
  }
  element system {
    style {
      shape rectangle
      color slate
    }
  }
  element service {
    style {
      shape rectangle
      color green
    }
  }
  element database {
    style {
      shape cylinder
      color blue
    }
  }
  element storage {
    style {
      shape rectangle
      color sky
    }
  }
  element queue {
    style {
      shape queue
      color amber
    }
  }
  element cache {
    style {
      shape rectangle
      color green
    }
  }
  element platform {
    style {
      shape rectangle
      color indigo
    }
  }
  element visualisation {
    style {
      shape rectangle
      color indigo
    }
  }
  element boundary {
    style {
      color muted
    }
  }
}

model {
  // External Boundary - Actors and Identity
  system defraCustomerId "Defra Customer ID" {
    description "Handles external users login and authentication"
    style {
      shape rectangle
      color indigo
    }
  }

  // AWS eu-west-2 (London) Region
  boundary awsEuWest2 "AWS eu-west-2 (London)" {
    description "AWS London region hosting CDP infrastructure"

    // Public Boundary CDP (AWS)
    boundary publicBoundaryCDP "Public Boundary CDP" {
      description "AWS Public Zone"

      cache redis "Redis" {
        description "Session cache for user sessions"
        technology "Redis"
      }

      service publicApp "CDP BNG Metric Public App & API" {
        description "Public-facing application and API for BNG metrics"
        technology "Node.js / AWS"
        style {
          color green
        }
      }
    }

    // Private Boundary CDP (AWS)
    boundary privateBoundaryCDP "Private Boundary CDP" {
      description "AWS Private Zone"

      service backendApi "CDP BNG Metric Backend API" {
        description "Backend API handling BNG metric processing"
        technology "Node.js / AWS"
        style {
          color green
        }
      }

      storage fileStorageS3 "File Storage - S3" {
        description "Used for any uploaded data by users, associated with case and user"
        technology "AWS S3"
        style {
          shape rectangle
          color sky
        }
      }

      storage bngProjectDataS3 "BNG Project Data - S3" {
        description "Stores BNG project updates/data for synchronisation with the GIO data platform"
        technology "AWS S3"
        style {
          shape rectangle
          color sky
        }
      }

      database mongoDb "CDP Mongo Database" {
        description "Mongo preferred for application data: users and RBAC, BNG information, also secondary store of GIS for convenience"
        technology "MongoDB"
      }

      database postgresDb "CDP Postgres / PostGIS Database" {
        description "PostGIS used to store reference data e.g. Living England habitats. Also stores user uploaded/created GIS layers associated with application"
        technology "PostgreSQL / PostGIS"
      }
    }
  }

  // Azure Data Platform
  boundary azureDataPlatform "Azure Data Platform" {
    description "Azure cloud services for reporting and data platform"

    platform dynamicsPlatform "Dynamics Platform / GIO Data Platform" {
      description "Core data platform for BNG data management"
      technology "Microsoft Dynamics"
    }
  }

  // Relationships

  // External to Public CDP
  defraCustomerId -> awsEuWest2.publicBoundaryCDP.publicApp "Authenticates users"

  // Within Public CDP
  awsEuWest2.publicBoundaryCDP.publicApp -> awsEuWest2.publicBoundaryCDP.redis "Session management"

  // Public to Private CDP
  awsEuWest2.publicBoundaryCDP.publicApp -> awsEuWest2.privateBoundaryCDP.backendApi "Internal API calls"

  // Within Private CDP
  awsEuWest2.privateBoundaryCDP.backendApi -> awsEuWest2.privateBoundaryCDP.fileStorageS3 "Stores uploaded files"
  awsEuWest2.privateBoundaryCDP.backendApi -> awsEuWest2.privateBoundaryCDP.bngProjectDataS3 "Stores BNG project data"
  awsEuWest2.privateBoundaryCDP.backendApi -> awsEuWest2.privateBoundaryCDP.mongoDb "Application data CRUD"
  awsEuWest2.privateBoundaryCDP.backendApi -> awsEuWest2.privateBoundaryCDP.postgresDb "GIS data operations"
  awsEuWest2.privateBoundaryCDP.bngProjectDataS3 -> azureDataPlatform.dynamicsPlatform "Sync"
}

views {
  view index {
    title "BNG Metric - Complete Flow"
    description "Complete view showing all components and their connections"

    // Include all actual components (not the boundary containers)
    include defraCustomerId
    include awsEuWest2.publicBoundaryCDP.redis
    include awsEuWest2.publicBoundaryCDP.publicApp
    include awsEuWest2.privateBoundaryCDP.backendApi
    include awsEuWest2.privateBoundaryCDP.fileStorageS3
    include awsEuWest2.privateBoundaryCDP.bngProjectDataS3
    include awsEuWest2.privateBoundaryCDP.mongoDb
    include awsEuWest2.privateBoundaryCDP.postgresDb
    include azureDataPlatform.dynamicsPlatform

    // This will automatically include all relationships between the included elements
  }
}
