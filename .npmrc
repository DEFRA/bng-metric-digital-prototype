audit=false
save-exact=true
min-release-age=7

# npm 12 refuses git and URL-tarball dependencies by default (allow-git / allow-remote =
# none). bng-library is pinned to a GitHub commit and xlsx comes from the SheetJS CDN, so
# allow both only for dependencies declared directly in package.json — a transitive
# dependency still cannot pull from a git remote or an arbitrary URL.
allow-git=root
allow-remote=root

# Supply-chain hardening: stop npm auto-running preinstall/install/postinstall/prepare
# scripts — ours or any dependency's — during `npm install` / `npm ci`. That's the vector
# recent npm worm attacks (e.g. Shai-Hulud) used to execute code at install time.
# `npm run <script>` still works for anything invoked explicitly. Override for a package
# that genuinely needs its install script with `npm install --ignore-scripts=false`.
ignore-scripts=true
