audit=false
save-exact=true
min-release-age=7

# npm 12 (in the CDP base image from node 24.22.1) refuses packages fetched from a
# URL or a git repo unless allowed. Two of ours are: xlsx (SheetJS publishes current
# versions only on its own CDN; the npm registry copy is outdated) and bng-library
# (installed from GitHub). "root" allows only those listed in our own package.json,
# so a dependency can't pull in its own URL or git packages.
allow-remote=root
allow-git=root

# Supply-chain hardening: stop npm auto-running preinstall/install/postinstall/prepare
# scripts — ours or any dependency's — during `npm install` / `npm ci`. That's the vector
# recent npm worm attacks (e.g. Shai-Hulud) used to execute code at install time.
# `npm run <script>` still works for anything invoked explicitly. Override for a package
# that genuinely needs its install script with `npm install --ignore-scripts=false`.
ignore-scripts=true
