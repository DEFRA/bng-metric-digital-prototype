// BNG Context Diagrams - User Interaction Flows
// Shows how each actor type interacts with the BNG system

specification {
  element actor {
    style {
      shape person
      color amber
    }
  }
  element system {
    style {
      shape rectangle
      color slate
    }
  }
  element service {
    style {
      shape rectangle
      color green
    }
  }
  element database {
    style {
      shape cylinder
      color blue
    }
  }
  element storage {
    style {
      shape rectangle
      color sky
    }
  }
  element platform {
    style {
      shape rectangle
      color indigo
    }
  }
  element boundary {
    style {
      color muted
    }
  }
}

model {
  // Actors
  actor bngCompleter "BNG Completer" {
    description "Developer or landowner completing a BNG metric submission as part of the planning process"
  }

  actor lpaOfficer "LPA Officer" {
    description "Local Planning Authority officer assessing BNG submissions against planning conditions"
  }

  // Identity Providers
  system defraCustomerId "Defra Customer ID" {
    description "Handles external users login and authentication"
    style {
      shape person
      color indigo
    }
  }

  system defraCustomerIdLpa "Defra Customer ID (LPA)" {
    description "Trusted Third-Party flow for LPA authentication"
    style {
      shape person
      color indigo
    }
  }

  // BNG System Boundary
  boundary bngSystem "BNG Digital Service" {
    description "The BNG digital service hosted on CDP"

    service publicApp "BNG Completion Front-end" {
      description "Public-facing application for BNG completion: define red-line boundaries, upload habitat data, map habitat parcels, and calculate biodiversity metrics"
      technology "Node.js / AWS"
      icon https://icons.terrastruct.com/dev%2Fnodejs.svg
      style {
        color green
      }
    }

    service lpaApp "LPA BNG Assessment Front-end" {
      description "LPA-facing application for reviewing and assessing BNG submissions against planning conditions"
      technology "Node.js / AWS"
      icon https://icons.terrastruct.com/dev%2Fnodejs.svg
      style {
        color green
      }
    }

    service backendApi "BNG Service Core API" {
      description "Backend API handling BNG metric processing, file management, and data persistence"
      technology "Node.js / AWS"
      icon https://icons.terrastruct.com/dev%2Fnodejs.svg
      style {
        color green
      }
    }

    database mongoDb "Application Database" {
      description "Stores user accounts, RBAC, BNG case data, and application state"
      technology "MongoDB"
      icon https://icons.terrastruct.com/dev%2Fmongodb.svg
    }

    database postgresDb "GIS Database" {
      description "Stores reference habitat data and user-created GIS layers"
      technology "PostgreSQL / PostGIS"
      icon https://icons.terrastruct.com/dev%2Fpostgresql.svg
    }

    storage fileStorageS3 "File Storage" {
      description "Stores uploaded documents, GeoPackages, and shapefiles"
      technology "AWS S3"
      icon https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg
    }
  }

  // External Services
  service govukNotify "GOV.UK Notify" {
    description "Sends email notifications to LPAs about new BNG submissions"
    technology "GOV.UK Notify"
    icon https://icons.terrastruct.com/aws%2FCustomer%20Engagement%2FAmazon-Simple-Email-Service-SES.svg
    style {
      color amber
    }
  }

  platform dynamicsPlatform "GIO Data Platform" {
    description "Central data platform for BNG reporting and data management"
    technology "Microsoft Dynamics"
    icon https://az-icons.com/export/icons/118053ce776aecf10590bb75db4a9b3b.svg
  }

  // ── BNG Completer Flow ──

  // Completer authenticates via Defra Customer ID
  bngCompleter -> defraCustomerId "Signs in with Defra account"

  // Defra Customer ID grants access to the completion front-end
  defraCustomerId -> bngSystem.publicApp "Authenticates"

  // Completer interacts with the front-end to build their BNG submission
  bngCompleter -> bngSystem.publicApp "Defines red-line boundary, uploads habitat data, maps parcels"

  // Front-end calls the backend API
  bngSystem.publicApp -> bngSystem.backendApi "Submits metric data and file uploads"

  // Backend persists data
  bngSystem.backendApi -> bngSystem.mongoDb "Stores case and metric data"
  bngSystem.backendApi -> bngSystem.postgresDb "Stores GIS layers and spatial queries"
  bngSystem.backendApi -> bngSystem.fileStorageS3 "Stores uploaded habitat files"

  // Submission triggers notification to LPA
  bngSystem.backendApi -> govukNotify "Notifies LPA of new submission"

  // Data syncs to central platform
  bngSystem.backendApi -> dynamicsPlatform "Syncs BNG project data"

  // ── LPA Officer Flow ──

  // LPA authenticates via Defra Customer ID (LPA)
  lpaOfficer -> defraCustomerIdLpa "Signs in via trusted third-party"

  // Defra Customer ID (LPA) grants access to the assessment front-end
  defraCustomerIdLpa -> bngSystem.lpaApp "Authenticates"

  // LPA officer interacts with the assessment front-end
  lpaOfficer -> bngSystem.lpaApp "Reviews submissions, assesses habitat parcels, checks metrics"

  // Assessment front-end calls the backend API
  bngSystem.lpaApp -> bngSystem.backendApi "Retrieves submission data and records assessments"

  // LPA receives notification emails
  govukNotify -> lpaOfficer "Receives email notification of new BNG submission"
}

views {
  // View 1: BNG Completer Context
  view completerContext {
    title "BNG Completer - User Context"
    description "Shows how a BNG completer (developer/landowner) interacts with the BNG digital service to submit biodiversity metric data"

    include bngCompleter
    include defraCustomerId
    include bngSystem.publicApp
    include bngSystem.backendApi
    include bngSystem.mongoDb
    include bngSystem.postgresDb
    include bngSystem.fileStorageS3
    include govukNotify
    include dynamicsPlatform
  }

  // View 2: LPA Officer Context
  view lpaContext {
    title "LPA Officer - User Context"
    description "Shows how an LPA officer interacts with the BNG digital service to assess and review BNG submissions"

    include lpaOfficer
    include defraCustomerIdLpa
    include bngSystem.lpaApp
    include bngSystem.backendApi
    include bngSystem.mongoDb
    include bngSystem.postgresDb
    include govukNotify
  }
}
