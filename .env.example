# Ordnance Survey Data Hub key for the project. Server-side only — it is never
# sent to the browser. Used by the interactive map pages (app/routes/os-api.js)
# and by the PDF site report's basemap (app/lib/pdf-report/os-tiles.mjs), both
# of which need the "OS NGD API – Tiles" product on the key's project.
#
# On CDP this is supplied as a secret via the Portal Frontend, not from a file.
OS_API_KEY=key
